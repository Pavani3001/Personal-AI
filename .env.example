# Nebius Token Factory API Key (Required for model inference)
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional: Nebius model name (defaults to nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B)
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Hosted PostgreSQL connection URL (Required for Vercel production deployment; optional for local development)
# Examples:
# Neon: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional local overrides (defaults to data/personal_ai.db and ./workspace)
# PERSONAL_AI_DATABASE=data/personal_ai.db
# PERSONAL_AI_WORKSPACE=workspace
